#!/usr/bin/env python3
import json, subprocess, glob, os

# 1. Dedicated NVIDIA GPU (GTX 1650)
nv_util, nv_temp = None, None
try:
    res = subprocess.run(
        ["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu", "--format=csv,noheader,nounits"],
        capture_output=True, text=True, timeout=2
    )
    if res.returncode == 0 and res.stdout.strip():
        parts = [p.strip() for p in res.stdout.strip().split(",")]
        if len(parts) >= 2:
            nv_util = int(parts[0])
            nv_temp = int(parts[1])
except Exception:
    pass

# 2. Integrated AMD Radeon Graphics
amd_temp = None
for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
    name_file = os.path.join(hwmon, "name")
    if os.path.exists(name_file):
        try:
            with open(name_file, "r") as f:
                name = f.read().strip()
            if name == "amdgpu":
                t_file = os.path.join(hwmon, "temp1_input")
                if os.path.exists(t_file):
                    with open(t_file, "r") as f:
                        amd_temp = float(f.read().strip()) / 1000.0
                    break
        except Exception:
            pass

bar_util = nv_util if nv_util is not None else 0
text = f"<span color='#ffee00'>{bar_util}%</span>"

nv_temp_str = f"{nv_temp}°C" if nv_temp is not None else "N/A (Suspended)"
nv_util_str = f"{nv_util}%" if nv_util is not None else "N/A"
amd_temp_str = f"{amd_temp:.1f}°C" if amd_temp is not None else "N/A"

tooltip = (
    f"<b>GPU Temperatures &amp; Status:</b>\n"
    f" • <b>NVIDIA GeForce GTX 1650:</b>\n"
    f"    Temp: <span color='#ffee00'><b>{nv_temp_str}</b></span>| Util: {nv_util_str}\n"
    f" • <b>AMD Radeon Graphics (iGPU):</b>\n"
    f"    Temp: <span color='#7aa2f7'><b>{amd_temp_str}</b></span>"
)

print(json.dumps({"text": text, "tooltip": tooltip}))
